<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bite's app-level privacy manifest.
	     Bundled plugins (webview_flutter, url_launcher, share_plus,
	     shared_preferences, sqflite) ship their own manifests; this file
	     covers what BITE itself does.

	     This must stay in step with two other documents that say the same
	     things to different audiences: the App Privacy answers in App Store
	     Connect (docs/appstore/app-privacy.md records the exact selections)
	     and the public privacy policy (docs/privacy/). If one changes, all
	     three change. -->

	<!-- No tracking. Bite has no advertising SDK, no analytics SDK, no
	     third-party identifiers, and it never links reader data to data from
	     other companies' apps or sites. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Email address: only when a reader chooses to create an account.
		     Guests never provide one. Used to sign in and to carry saves
		     between devices; never used for advertising and never sold. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- User ID: the Supabase account identifier, including the anonymous
		     one issued to guests. It is what row-level security keys on, so
		     every reader sees only their own saves and history. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Product interaction: swipes, saves, opens, and the impression /
		     link-out counts behind publisher click-through reporting. This is
		     the recommendation engine's entire input, so it is genuinely
		     App Functionality — but it also produces the aggregate CTR figures
		     shared with publishers, which is Analytics, and both are declared
		     rather than picking the flattering one. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- User defaults: the appearance preference, stored on-device by
		     LocalPrefs. CA92.1 = read/write of information accessible only to
		     this app. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
