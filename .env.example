# Copy to .env and fill in. The app runs on bundled mock data if these are absent.
#
# ZERO news-API keys belong in this file — it is bundled into the app. The
# Guardian and NewsData keys live exclusively in Edge Function secrets
# (supabase/functions/.env.secrets): the feed is ingested server-side
# (ingest-news) and the reader fetches Guardian bodies through the
# guardian-body function.

# Supabase project (Settings → API in the dashboard). Persistence is skipped
# when these are absent — the app falls back to in-memory state.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shared secret for the guardian-body Edge Function (sent as the
# x-body-secret header) — same value as BODY_FN_SECRET in
# supabase/functions/.env.secrets. A light gate against anonymous scripted
# calls, NOT a news-API key: it unlocks only the body proxy, never
# ingest-news or embed (their secrets must never appear here).
BODY_FN_SECRET=
